# Host test harness: make -f Makefile.host && ./run_tests.sh
CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -Wno-unused-parameter
all: host_sv host_cpu_test
host_sv: host_main.c supervision.c svcore.h cpu65c02.h
	$(CC) $(CFLAGS) -DHOST_TEST -o $@ host_main.c
host_cpu_test: host_cpu_test.c cpu65c02.h
	$(CC) $(CFLAGS) -o $@ host_cpu_test.c
clean:
	rm -f host_sv host_cpu_test
